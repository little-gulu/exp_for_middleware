{
  "name": "product-center-connector-v2",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "dbz123456",
    "database.server.id": "54001",
    "database.include.list": "demo",
    "table.include.list": "demo.category,demo.attribute_meta,demo.spu,demo.sku",
    "topic.prefix": "demo",
    "schema.history.internal.kafka.topic": "schema-history-v2",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "decimal.handling.mode": "double",
    "snapshot.mode": "initial",
    "include.schema.changes": "false",
    "transforms": "route",
    "transforms.route.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.route.topic.regex": "demo.demo.(category|attribute_meta|spu|sku)",
    "transforms.route.topic.replacement": "product.changed",
    "transforms.route.key.enforce.uniqueness": "false"
  }
}
